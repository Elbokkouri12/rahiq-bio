# HTML — دائماً fresh (تظهر التعديلات فوراً)
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# JS و CSS — دائماً يتحقق من التحديث (المنتجات والأسعار موجودة فـ script.js)
/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

# صور — 30 يوم (نادراً ما تتغير)
/assets/images/*
  Cache-Control: public, max-age=2592000, immutable

# فيديوهات — 7 أيام
/assets/videos/*
  Cache-Control: public, max-age=604800
